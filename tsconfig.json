{
  // Type-checking is opted into per file with a `// @ts-check` directive on the
  // first line - that is what `checkJs: false` means here. Files without the
  // directive are still parsed (so cross-file globals resolve) but not reported
  // on, which keeps `make typecheck` green while the codebase is converted one
  // file at a time. The last step of the rollout flips this to true and drops
  // the directives.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // No `module` setting on purpose. The browser code is <script> globals with
    // no import/export anywhere, and TypeScript only treats such a file as a
    // shared global script while it is not in a module context. Setting
    // `module: node16` here makes every .js its own CommonJS module, and the
    // helpers in utils.js / dom-utils.js / common.js stop resolving across
    // files - 105 spurious TS2304 reports. The Node-side code needs the
    // opposite, so it lives in tsconfig.node.json.
    "strict": false,
    "types": []
  },
  "include": [
    "www/**/*.js",
    "www/**/*.d.ts"
  ],
  "exclude": [
    "**/node_modules/**",
    "www/**/vendor/**",
    "www/**/*.min.js"
  ]
}

.vscode
/node_modules/
/.html-check/
/www/.github
/www/tools
# Everything under .claude is local (plans/, settings.local.json, session state),
# except the agent instructions themselves - those are part of the project.
.claude/*
!.claude/skills/
!.claude/commands/
# A Claude Code session started from inside .claude/commands drops its own
# settings there; commands/ is versioned now, so keep that out.
.claude/commands/.claude/
setup-statusline.ps1
/.mcp.json
/run_tests.bat
changelog.sql
/docs/vps-deploy-notes.md
.env
feature-description.txt 

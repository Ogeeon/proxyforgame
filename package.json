{
  "name": "proxyforgame",
  "version": "1.0.0",
  "description": "OGame calculator website - ProxyForGame",
  "private": true,
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "validate-translations": "node scripts/validate-translations.js",
    "sync-translations": "node scripts/sync-translations.js",
    "sync-translations:report": "node scripts/sync-translations.js --report",
    "sync-translations:show": "node scripts/sync-translations.js --report --show-keys",
    "sync-translations:fix": "node scripts/sync-translations.js --fix",
    "sync-translations:dry": "node scripts/sync-translations.js --dry-run",
    "check-test-coverage": "node scripts/check-test-coverage.js",
    "generate-test": "node scripts/generate-test.js",
    "new-calculator": "node scripts/new-calculator.js",
    "refactor-calculator": "node scripts/refactor-calculator.js",
    "update-asset-versions": "node scripts/update-asset-versions.js",
    "validate-database": "node scripts/validate-database-schema.js",
    "generate-docs": "node scripts/generate-docs.js"
  },
  "keywords": [
    "ogame",
    "calculator",
    "php"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@popperjs/core": "^2.11.8",
    "@types/bootstrap": "^5.2.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "typescript": "^5.9.0"
  }
}

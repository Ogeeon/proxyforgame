# Copy to .env in the repo root and fill in. .env is gitignored and never
# deployed - each host keeps its own, written by the cutover script and then
# maintained by hand. pfg-sync preserves it across every reset.

# --- Database (www/db.connect.inc.php) ---
DB_HOST=127.0.0.1
DB_USER=pfg_usr
DB_NAME=proxyforgame
DB_PASS=secret

# --- DDL user for deploy/pfg-migrate. Optional: leave unset where DB_USER can
#     already run ALTER/CREATE (production, via ISPmanager). Set on the standby,
#     whose pfg_app deliberately has no schema privileges. ---
#DB_DDL_USER=root
#DB_DDL_PASS=

# --- Outgoing mail: contact form (www/api/mail.inc.php) and deploy failure
#     alerts (deploy/pfg-notify). A Gmail account plus an app password. ---
SMTP_USER=you@example.com
SMTP_PASS=app-password

# --- Where deploy/pfg-cron-run writes its stamp files; read back by
#     ajax.php?service=health so the watchdog can see the crons are alive.
#     Must equal STAMP_DIR in /etc/pfg-cron.conf. Outside the checkout, because
#     pfg-sync runs `git clean` on every deploy. ---
JOB_STAMP_DIR=/var/lib/pfg/job-stamps

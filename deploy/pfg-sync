#!/bin/bash
#
# Bring the site to a commit of GitHub main through release directories, then
# prove it still serves. This is the ONLY thing that writes to a release - the
# webhook calls it, the reconcile timer calls it, and a human rolling back
# calls it.
#
#   pfg-sync                 sync to the newest commit of main whose CI passed
#   pfg-sync --sha <sha>     sync to exactly that commit (webhook / rollback)
#   pfg-sync --check         report drift and exit; change nothing
#
# Layout (issue #14 - release directories behind the docroot symlink):
#
#   REPO_DIR        bare repository, the shared object store. The only thing
#                   that is ever fetched; every release is a worktree of it.
#   RELEASES_DIR    one worktree per deployed commit, named by its full sha.
#                   A directory that exists under that name is complete:
#                   worktrees are built under a .tmp- name and renamed into
#                   place (rename(2) is atomic).
#   CURRENT_LINK    symlink to the live release. The crontab's jobs and the
#                   MCP server go through it - nothing outside this script
#                   names a release directory directly.
#   DOCROOT_LINK    optional symlink to <live release>/www that the web
#                   server's document root goes through. Flipped with
#                   CURRENT_LINK on every deploy: PHP's opcache keeps serving
#                   the compiled code of a path it has already cached (with
#                   __DIR__ folded in at compile time), and an indirection
#                   whose target changes while the path stays the same is
#                   exactly that. One release, one set of paths.
#   SHARED_ENV      the one real .env, the only file git cannot recreate.
#                   Every release links to it; a deploy never copies, saves
#                   or restores it again.
#   KEEP_RELEASES   how many releases to keep. The current release and the
#                   one it replaced are never pruned - the second is the
#                   rollback.
#
# A deploy is one atomic rename of CURRENT_LINK, so a request is served either
# the whole old release or the whole new one; a half-updated tree cannot
# exist, which is the whole point of the layout. A rollback - dispatched or
# by hand - is the same rename pointed at a release that already exists, or
# one rebuilt from the store.
#
# Config comes from PFG_SYNC_CONF, else /etc/pfg-sync.conf, else
# ~/.pfg-sync.conf. It defines the layout keys above plus SMOKE_BASE,
# SMOKE_RESOLVE, SMOKE_INSECURE, LOG, LOCK, MAIL_TO, MAX_WALK and
# MCP_RESTART_FILE. A config that still names CHECKOUT is the pre-#14
# single-checkout layout; it is refused with a pointer to deploy/README.md
# rather than half-working.
#
# Deliberately still NOT `git pull`: a pull can merge, and merges are how the
# previous Bitbucket checkout accumulated 26 commits that existed nowhere
# else. A detached worktree at an exact sha is a snapshot that cannot drift,
# and there is no `git clean` either - a fresh worktree has nothing stray in
# it to sweep, and the gitignored .env is not git's to touch at all.
#
# The target is always resolved from origin/main after a fetch: the tip if its
# CI has gone green, else the newest ancestor that has - but never a commit
# below the one already deployed, so green mode cannot roll back. Older history
# is never a candidate - a stale answer from the runs API once reset a host six
# months back, and the reset onto and back off a commit that still tracked
# .env destroyed the file. The releases hold no .env of their own any more,
# but the ancestor rule stays: going back is the pin's job, not green mode's.
#
set -euo pipefail

REPO_API=https://api.github.com/repos/Ogeeon/proxyforgame
CI_WORKFLOW=playwright.yml   # file name, not display name - the workflow is called "CI"

MODE=green
WANT_SHA=""
while [ $# -gt 0 ]; do
  case "$1" in
    --sha)   MODE=exact; WANT_SHA="${2:-}"; shift 2 ;;
    --check) MODE=check; shift ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
done

CONF="${PFG_SYNC_CONF:-}"
[ -z "$CONF" ] && [ -r /etc/pfg-sync.conf ] && CONF=/etc/pfg-sync.conf
[ -z "$CONF" ] && [ -r "$HOME/.pfg-sync.conf" ] && CONF="$HOME/.pfg-sync.conf"
[ -n "$CONF" ] || { echo "pfg-sync: no config file found" >&2; exit 2; }
# shellcheck disable=SC1090
. "$CONF"
if [ -n "${CHECKOUT:-}" ]; then
  echo "pfg-sync: this config names CHECKOUT - the single-checkout layout. The" >&2
  echo "pfg-sync: release layout needs REPO_DIR, RELEASES_DIR, CURRENT_LINK and" >&2
  echo "pfg-sync: SHARED_ENV instead; see deploy/README.md, 'The host'." >&2
  exit 2
fi
: "${REPO_DIR:?REPO_DIR not set in $CONF}"
: "${RELEASES_DIR:?RELEASES_DIR not set in $CONF}"
: "${CURRENT_LINK:?CURRENT_LINK not set in $CONF}"
: "${SHARED_ENV:?SHARED_ENV not set in $CONF}"
: "${SMOKE_BASE:?SMOKE_BASE not set in $CONF}"
DOCROOT_LINK="${DOCROOT_LINK:-}"
LOG="${LOG:-/dev/null}"
LOCK="${LOCK:-/tmp/pfg-sync.lock}"
MAIL_TO="${MAIL_TO:-}"
SMOKE_RESOLVE="${SMOKE_RESOLVE:-}"
SMOKE_INSECURE="${SMOKE_INSECURE:-}"
MAX_WALK="${MAX_WALK:-20}"
KEEP_RELEASES="${KEEP_RELEASES:-5}"
MCP_RESTART_FILE="${MCP_RESTART_FILE:-}"

log() { printf '%s %s\n' "$(date -Is)" "$*" >> "$LOG"; }
fail() {
  log "FAILED: $*"
  [ -n "$MAIL_TO" ] && [ -x "$(dirname "$0")/pfg-notify" ] && "$(dirname "$0")/pfg-notify" \
      "ProxyForGame deploy FAILED on $(hostname)" "$*" || true
  echo "pfg-sync: $*" >&2
  exit 1
}

# ---------------------------------------------------------------------------
# Pipe a release's changelog.sql into this host's database. changelog.sql is
# committed and every statement in it is an upsert, so this is a no-op on a
# database that already has the entry and a catch-up on one that is behind.
#
# The in-release copy is run, not an installed one: it does no git work, the
# release is quiescent by the time it runs, and this way it always matches the
# code just deployed. A failure is logged and swallowed - the site code is
# already live and correct; only the changelog rows would lag one release.
#
# Called only when a deploy actually moved the site (or a --sha was
# re-asserted), never on an idle green-mode reconcile, so the five-minute
# timer does not write a log line every time it finds nothing to do.
# ---------------------------------------------------------------------------
apply_changelog() {
  local applier="$1/deploy/pfg-changelog-apply"
  [ -x "$applier" ] || return 0
  "$applier" "$1" >> "$LOG" 2>&1 \
    || log "WARNING: changelog apply failed - code is deployed, sidebar rows may lag one release"
}

# ---------------------------------------------------------------------------
# Apply a release's db/migrations/*.sql to this host's database before the
# site is switched to it. Same in-release copy, same reasons as
# apply_changelog. UNLIKE the changelog, a failure here is fatal: the code
# about to go live may need the schema. But it is fatal without consequences
# now - the old release is still what the document root serves, so the caller
# drops the new release and the site never notices. Expand-only migrations
# keep that old release compatible with a half-applied change.
# ---------------------------------------------------------------------------
apply_migrations() {
  local migrator="$1/deploy/pfg-migrate"
  [ -x "$migrator" ] || { log "NOTE: $migrator missing - skipping migrations"; return 0; }
  "$migrator" "$1" >> "$LOG" 2>&1
}

# ---------------------------------------------------------------------------
# Ask for the MCP server to be restarted onto the code just deployed. It loads
# the calculator scripts once, at start, so until it restarts it keeps
# computing with the release before. This script runs as www-data and cannot
# call systemctl; it writes the commit to a file and a systemd path unit
# (deploy/pfg-mcp-restart.path) does the restart.
#
# Only after a deploy that passed its smoke test: a rolled-back deploy put the
# old files back, and the running server already has the old code in memory.
# A failure is logged, not fatal - the site is fine, and the watchdog reports
# a server whose commit lags the site's.
# ---------------------------------------------------------------------------
signal_mcp() {
  [ -n "$MCP_RESTART_FILE" ] || return 0
  printf '%s\n' "$1" > "$MCP_RESTART_FILE" 2>/dev/null \
    || log "WARNING: could not write $MCP_RESTART_FILE - the MCP server keeps the previous release"
}

# ---------------------------------------------------------------------------
# git fetch into the store, retried. GitHub now and then answers an
# unauthenticated fetch with a 401 - "could not read Username for
# 'https://github.com'" - for a few minutes at a stretch, a transient blip
# rather than a real outage. One was ridden out on 2026-08-31 by waiting;
# retrying here spares the alarm mail for a wobble that fixes itself.
# GIT_TERMINAL_PROMPT=0 turns the credential prompt that 401 provokes into an
# immediate error instead of a read against cron's dead stdin.
#
# http.version=HTTP/1.1 is pinned because from 2026-09-02 the HTTP/2 POST to
# github.com/.../git-upload-pack started hanging from the host - the GET that
# advertises the refs is served fine over h2, the POST that negotiates the pack
# resets ("the remote end hung up unexpectedly", or "expected flush after ref
# listing"), and git then falls through to a credential prompt and reports
# "could not read Username for 'https://github.com'". Old libcurl (git 2.30.2,
# no root to upgrade) against GitHub's edge; curl and a newer git are both
# unaffected. Forcing HTTP/1.1 sidesteps the broken h2 upload entirely.
#
# `timeout` bounds each attempt: git has no overall deadline of its own, and on
# 2026-10-03 a connection to GitHub that stalled without closing held the lock
# for over ten minutes, so the next two timer runs gave up on it and mailed.
# ---------------------------------------------------------------------------
fetch_main() {
  local attempt=1 delay
  while :; do
    GIT_TERMINAL_PROMPT=0 timeout 60 git -C "$REPO_DIR" -c http.version=HTTP/1.1 fetch --quiet origin main \
      && return 0
    [ "$attempt" -ge 3 ] && return 1
    delay=$((attempt * 10))
    log "git fetch failed (attempt $attempt/3) - retrying in ${delay}s"
    sleep "$delay"
    attempt=$((attempt + 1))
  done
}

# ---------------------------------------------------------------------------
# GET a GitHub API URL, print the body. Same three tries as fetch_main, for
# the same reason: a single unanswered request is a blip, not an outage, and
# the five-minute timer would otherwise mail about every one of them.
# --max-time keeps a stalled connection from holding the lock indefinitely.
# ---------------------------------------------------------------------------
api_get() {
  local attempt=1
  while :; do
    curl -sf --connect-timeout 10 --max-time 20 \
      -H 'Accept: application/vnd.github+json' "$1" && return 0
    [ "$attempt" -ge 3 ] && return 1
    sleep $((attempt * 5))
    attempt=$((attempt + 1))
  done
}

# ---------------------------------------------------------------------------
# Did CI (a push run of $CI_WORKFLOW) conclude successfully for exactly this
# commit? Filtering by head_sha is an exact match - unlike a bare per_page=1
# on the runs list, whose order GitHub does not guarantee.
#
#   0  yes           1  no run, or none successful           2  API unreachable
# ---------------------------------------------------------------------------
ci_passed() {
  local sha="$1" json count
  json=$(api_get \
    "$REPO_API/actions/workflows/$CI_WORKFLOW/runs?head_sha=$sha&event=push&status=success&per_page=1") \
    || return 2
  count=$(printf '%s' "$json" | grep -oE '"total_count"[[:space:]]*:[[:space:]]*[0-9]+' \
    | grep -oE '[0-9]+' | head -1) || true
  [ -n "$count" ] && [ "$count" -gt 0 ]
}

# ---------------------------------------------------------------------------
# The commit a dispatched rollback pinned this host to, or empty.
#
# A rollback is `deploy.yml` creating a deployment for an older commit. That
# reaches the host as a webhook delivery, but the five-minute timer reconciles
# in green mode too - which, left alone, walks back to the newest green commit
# of main and undoes the rollback within five minutes.
#
# So green mode asks GitHub for the newest deployment and honours it as a pin.
# The pin lapses on its own when main moves: `deploy.yml` records the tip it
# saw at dispatch time in the deployment payload, and the pin only applies
# while the tip is still that commit. Landing the fix - a `git revert`,
# normally - is therefore all it takes to resume rolling forward, and a
# rollback dispatched at the current tip is not a pin at all.
#
# CI is deliberately not re-checked for a pinned commit: `deploy.yml` already
# proved it is an ancestor of main, and an older commit's workflow runs can
# have aged out of the API entirely.
#
# Prints the sha to pin to, or nothing. Never fails the run - an unreachable
# API here means "no pin", and the green walk below has its own API guard.
# ---------------------------------------------------------------------------
pinned_target() {
  local tip="$1" json sha pinned_tip
  json=$(api_get "$REPO_API/deployments?environment=production&per_page=1") || return 0
  # Grep by key name rather than by position: the keys below are unique in the
  # response, so this does not care that pinned_tip sits inside `payload`.
  sha=$(printf '%s' "$json" | grep -oE '"sha"[[:space:]]*:[[:space:]]*"[0-9a-f]{40}"' \
    | grep -oE '[0-9a-f]{40}' | head -1) || true
  pinned_tip=$(printf '%s' "$json" \
    | grep -oE '"pinned_tip"[[:space:]]*:[[:space:]]*"[0-9a-f]{40}"' \
    | grep -oE '[0-9a-f]{40}' | head -1) || true
  [ -n "$sha" ] || return 0
  # An old deployment from before this field existed, or one dispatched against
  # a main that has since moved: the pin has lapsed.
  [ "$pinned_tip" = "$tip" ] || return 0
  # A deployment for the tip itself is a roll-forward, not a rollback.
  [ "$sha" != "$tip" ] || return 0
  git -C "$REPO_DIR" merge-base --is-ancestor "$sha" "$tip" 2>/dev/null || return 0
  printf '%s' "$sha"
}

# ---------------------------------------------------------------------------
# The smoke test, as a function so a flip-back can re-run it. Prints the list
# of things that are wrong (empty when the site is healthy); never exits.
# ---------------------------------------------------------------------------
smoke() {
  local bad="" path body code size
  local -a curl_cmd
  curl_cmd=(curl -s --max-time 20)
  [ -n "$SMOKE_RESOLVE" ] && curl_cmd+=(--resolve "$SMOKE_RESOLVE")
  [ "$SMOKE_INSECURE" = 1 ] && curl_cmd+=(--insecure)

  # The calculators answer on /<lang>/<calc> and redirect their old .php paths
  # there, so redirects are followed: the old paths prove the redirect and the
  # page behind it, and still pass on a rollback to a commit from before the
  # short addresses. A redirect off $SMOKE_BASE would escape --resolve and test
  # some other host, so the final URL has to stay on it.
  local effective
  for path in "/" "/ru/" "/ogame/calc/flight.php" "/ogame/calc/costs.php"; do
    body=$(mktemp)
    # curl -w prints 000 on a connection failure and also exits non-zero; the
    # || keeps that from turning into "000000", it does not add a second code.
    effective=$("${curl_cmd[@]}" -L -o "$body" -w '%{http_code} %{url_effective}' "$SMOKE_BASE$path") || effective="000 "
    code=${effective%% *}; effective=${effective#* }
    size=$(wc -c < "$body"); rm -f "$body"
    if [ "$code" != 200 ] || [ "$size" -lt 1000 ]; then
      bad="$bad $path(HTTP $code, ${size}b)"
    elif [ "${effective#"$SMOKE_BASE"/}" = "$effective" ]; then
      bad="$bad $path(redirected off the host to $effective)"
    fi
  done
  # One database-backed read. A static page cannot tell us the .env behind the
  # release is reachable or that MySQL is answering; this can.
  body=$(mktemp)
  code=$("${curl_cmd[@]}" -o "$body" -w '%{http_code}' \
    "$SMOKE_BASE/ajax.php?service=populatedSystems&country=ru&universe=268") || code=000
  grep -q '"populatedSystems"' "$body" || bad="$bad ajax/populatedSystems(HTTP $code)"
  rm -f "$body"

  printf '%s' "$bad"
}

# ---------------------------------------------------------------------------
# The commit the current link points at, or empty when there is no release
# (a host mid-bootstrap). The directory a release lives in is named for its
# sha, but reading git is the honest answer - it is what the site serves.
# ---------------------------------------------------------------------------
current_sha() {
  local rel
  rel=$(readlink -f "$CURRENT_LINK" 2>/dev/null) || return 0
  [ -n "$rel" ] || return 0
  git -C "$rel" rev-parse HEAD 2>/dev/null || true
}

# ---------------------------------------------------------------------------
# Point every release's .env at the shared file. The one file git may put in
# the way is the committed placeholder: .env was a tracked file until 8ac690a,
# so a release of an older commit carries it as a real file, and it is simply
# replaced. A release that already has the right link is left untouched - it
# may be the one the site is serving, and rm+ln would leave it without an .env
# for an instant.
# ---------------------------------------------------------------------------
link_env() {
  [ "$(readlink "$1/.env" 2>/dev/null || true)" = "$SHARED_ENV" ] && return 0
  rm -f "$1/.env"
  ln -s "$SHARED_ENV" "$1/.env"
}

# ---------------------------------------------------------------------------
# Build RELEASES_DIR/<sha> as a worktree of the store: complete or absent,
# never half-written. git checks out under a .tmp- name; the finished tree is
# renamed into place, and the name a release is known by never exists until
# the worktree is whole - a [ -d ] test on it is a completeness guarantee.
#
# A .tmp left behind by an interrupted run is cleaned first: worktree remove
# when git still knows it, rm -rf when it does not, prune to drop the stale
# metadata. The move itself breaks the store's record of where the worktree
# lives, and `worktree repair` needs the worktree's NEW path to fix it - with
# no argument it only checks records it can already resolve, and the next
# prune would then call the finished release abandoned and drop it.
# ---------------------------------------------------------------------------
ensure_release() {
  local sha="$1" release="$RELEASES_DIR/$1" tmp="$RELEASES_DIR/.tmp-$1"
  if [ -d "$release" ]; then
    link_env "$release"
    return 0
  fi
  git -C "$REPO_DIR" worktree remove --force "$tmp" >/dev/null 2>&1 || rm -rf "$tmp"
  git -C "$REPO_DIR" worktree prune
  git -C "$REPO_DIR" worktree add --quiet --detach "$tmp" "$sha" \
    || fail "git worktree add for $sha failed"
  link_env "$tmp"
  mv -T "$tmp" "$release"
  git -C "$REPO_DIR" worktree repair "$release"
}

# ---------------------------------------------------------------------------
# Point a link at a target with one atomic rename: ln builds the new link
# beside the old one, mv -T renames it over. `ln -sfn` alone would do an
# unlink+symlink instead, and for an instant in between there would be no link
# at all - every request in that instant an error. The document root and the
# current-release link are swapped this way, so these are the renames on the
# host that must be atomic.
# ---------------------------------------------------------------------------
flip_link() {
  local tmp="$1.tmp.$$"
  ln -s "$2" "$tmp"
  mv -T "$tmp" "$1"
}

# The document root link moves to the release's own www, not through
# CURRENT_LINK: opcache keeps serving the compiled code of a path it has
# already cached, __DIR__ folded in at compile time, and an indirection whose
# target changes while the path stays the same leaves every PHP file on the
# old release until the cache drops it. Pointing the link straight at each
# release gives every deploy a set of paths nothing has cached yet, so the
# new code is what runs from the first request after the flip.
flip_site() {
  flip_link "$CURRENT_LINK" "$1"
  [ -z "$DOCROOT_LINK" ] || flip_link "$DOCROOT_LINK" "$1/www"
}

# ---------------------------------------------------------------------------
# Keep the newest KEEP_RELEASES releases; the current one and the release it
# replaced are untouchable whatever their age - the second is the rollback.
# Newest is mtime, which is creation order here: a release is written once
# and never modified. Removal goes through `git worktree remove`, never
# rm -rf, so the store's worktree metadata stays consistent.
# ---------------------------------------------------------------------------
prune_releases() {
  local current="$1" prev="$2" r path kept=0
  while IFS= read -r r; do
    [ -n "$r" ] || continue
    path="$RELEASES_DIR/$r"
    if [ "$path" = "$current" ] || { [ -n "$prev" ] && [ "$path" = "$prev" ]; }; then
      kept=$((kept + 1))
      continue
    fi
    if [ "$kept" -lt "$KEEP_RELEASES" ]; then
      kept=$((kept + 1))
      continue
    fi
    git -C "$REPO_DIR" worktree remove --force "$path" \
      || log "NOTE: could not prune $r - left in place"
  done < <(ls -1t "$RELEASES_DIR" 2>/dev/null | grep -E '^[0-9a-f]{40}$' || true)
  git -C "$REPO_DIR" worktree prune
}

# One deploy at a time. A second delivery arriving mid-flip would otherwise
# see the layout half-moved, and GitHub can deliver two events for one push.
#
# A timer reconcile that finds the lock taken just steps aside: whoever holds
# it is doing the same job, and the next tick tries again. A host that stays
# stuck shows up as drift in the watchdog, so nothing goes unreported. A --sha
# (webhook, rollback) or --check still waits, and still fails loudly - that
# instruction would otherwise be lost.
exec 9>"$LOCK"
if [ "$MODE" = green ]; then
  flock -n 9 || { log "another pfg-sync holds the lock - skipping this run"; exit 0; }
else
  flock -w 120 9 || fail "another pfg-sync held the lock for over two minutes"
fi

[ -d "$REPO_DIR" ] || fail "object store $REPO_DIR is not there - see deploy/README.md, 'Rebuilding the host'"
[ -d "$RELEASES_DIR" ] || fail "releases directory $RELEASES_DIR is not there"

# ---------------------------------------------------------------------------
# origin/main is the frame of reference for both modes: every target has to be
# it or an ancestor of it. Fetch before deciding anything.
# ---------------------------------------------------------------------------
fetch_main || fail "git fetch failed after 3 attempts - leaving the site alone"
TIP=$(git -C "$REPO_DIR" rev-parse FETCH_HEAD)

# ---------------------------------------------------------------------------
# Which commit do we want?
# ---------------------------------------------------------------------------
if [ "$MODE" = exact ]; then
  # A sha reaches this from an HTTP payload; let nothing else through.
  case "$WANT_SHA" in
    *[!0-9a-fA-F]* | "") fail "refusing a target that is not a hex sha: '$WANT_SHA'" ;;
  esac
  [ ${#WANT_SHA} -ge 7 ] || fail "sha too short: '$WANT_SHA'"
  git -C "$REPO_DIR" cat-file -e "$WANT_SHA^{commit}" 2>/dev/null \
    || fail "$WANT_SHA is not in the fetched history"
  git -C "$REPO_DIR" merge-base --is-ancestor "$WANT_SHA" "$TIP" \
    || fail "$WANT_SHA is not an ancestor of origin/main - refusing it"
  WANT_SHA=$(git -C "$REPO_DIR" rev-parse "$WANT_SHA") || fail "cannot resolve $WANT_SHA"
else
  # A dispatched rollback outranks the walk: while it holds, this host stays on
  # the commit it names instead of climbing back to the tip.
  PIN=$(pinned_target "$TIP")
fi

# --check reports what this host should be at, so it honours the pin too -
# otherwise a correctly pinned host reads as drifted to the watchdog.
if [ "$MODE" != exact ] && [ -n "${PIN:-}" ]; then
  WANT_SHA="$PIN"
  [ "$(current_sha)" = "$WANT_SHA" ] \
    || log "pinned to ${WANT_SHA:0:8} by a dispatched rollback (main is at ${TIP:0:8})"
elif [ "$MODE" != exact ]; then
  # The tip of main if its CI has gone green, otherwise the newest ancestor
  # whose CI has - walking first-parent, never further than MAX_WALK. A tip
  # that is still building simply resolves to the commit already deployed, so
  # the timer waits for CI instead of racing it.
  #
  # The walk tolerates gaps: GitHub runs the workflow only for the commit a
  # push points at, so the intermediate commits of a multi-commit push have no
  # run of their own and answer "no". MAX_WALK has to comfortably exceed the
  # largest push anyone realistically lands while CI is mid-flight.
  #
  # The walk stops at the commit already deployed and takes it without asking
  # the API: it got here green (or by an explicit --sha), and green mode only
  # ever rolls forward - rolling back is the pin's job. The runs API answers
  # "no successful run" for a commit that has one now and then; before this,
  # every such answer for the tip put the host one commit back for a cycle,
  # several times a day (from 2026-09-28). It also means an idle reconcile
  # makes no API call at all.
  HAVE_SHA=$(current_sha)
  sha="$TIP"
  n=0
  WANT_SHA=""
  while [ "$n" -lt "$MAX_WALK" ]; do
    if [ "$sha" = "$HAVE_SHA" ]; then WANT_SHA="$sha"; break; fi
    rc=0
    ci_passed "$sha" || rc=$?
    if [ "$rc" -eq 0 ]; then WANT_SHA="$sha"; break; fi
    [ "$rc" -eq 2 ] && fail "GitHub API unreachable - leaving the site alone"
    sha=$(git -C "$REPO_DIR" rev-parse --verify --quiet "$sha^") || break
    n=$((n + 1))
  done
  # A push of more than MAX_WALK commits whose first-parent chain does not pass
  # through the deployed commit (a merged feature branch) exhausts the walk with
  # no run to find - only the tip has one, and it is still building. The host
  # is on an ancestor of the tip, so staying put is safe and the tip's own
  # workflow_run delivers the deploy. A deployed commit that is NOT an ancestor
  # means history was rewritten, and that still fails loudly.
  if [ -z "$WANT_SHA" ] && [ -n "$HAVE_SHA" ] \
     && git -C "$REPO_DIR" merge-base --is-ancestor "$HAVE_SHA" "$TIP" 2>/dev/null; then
    log "no CI-passed commit within $MAX_WALK of ${TIP:0:8} yet - staying on ${HAVE_SHA:0:8} until CI finishes"
    WANT_SHA="$HAVE_SHA"
  fi
  [ -n "$WANT_SHA" ] \
    || fail "no CI-passed commit within $MAX_WALK of origin/main (${TIP:0:8}) - is main red?"
fi

HAVE_SHA=$(current_sha)
if [ "$HAVE_SHA" = "$WANT_SHA" ]; then
  if [ "$MODE" = check ]; then
    echo "up to date at $HAVE_SHA"
  elif [ "$MODE" = exact ]; then
    # A webhook redelivery or a rollback re-assertion: the site is already on
    # the commit, but "apply the migrations and the changelog" is still part of
    # that instruction. Nothing moved, so a migration failure only warns here.
    RELEASE=$(readlink -f "$CURRENT_LINK")
    apply_migrations "$RELEASE" \
      || log "WARNING: migration apply failed on --sha re-assert of ${WANT_SHA:0:8}"
    apply_changelog "$RELEASE"
  fi
  exit 0
fi

if [ "$MODE" = check ]; then
  echo "DRIFT: site is at ${HAVE_SHA:-no release}, wanted $WANT_SHA"
  log "drift detected: ${HAVE_SHA:-none} != $WANT_SHA"
  exit 1
fi

# ---------------------------------------------------------------------------
# Deploy: build the release aside, migrate it, flip the link, prove the site.
# ---------------------------------------------------------------------------
log "syncing ${HAVE_SHA:-<none>} -> $WANT_SHA"

NEW_RELEASE="$RELEASES_DIR/$WANT_SHA"
CREATED=no
[ -d "$NEW_RELEASE" ] || CREATED=yes
# A release that already exists is a rollback to it (or a re-deploy after a
# smoke failure); it is reused as it stands. One that does not is built.
ensure_release "$WANT_SHA"

PREV_RELEASE=$(readlink -f "$CURRENT_LINK" 2>/dev/null || true)

# ---------------------------------------------------------------------------
# Schema before the switch. The document root still serves the old release
# while the new code's migrations run against the new release's own tree, so
# a failure here never reaches a visitor: the new release is dropped, the old
# one never stopped serving, and the mail says what happened.
# ---------------------------------------------------------------------------
if ! apply_migrations "$NEW_RELEASE"; then
  log "migration failed on ${WANT_SHA:0:8} - the site keeps ${HAVE_SHA:-<none>}"
  if [ "$CREATED" = yes ]; then
    git -C "$REPO_DIR" worktree remove --force "$NEW_RELEASE" \
      || log "NOTE: could not remove $NEW_RELEASE - remove it by hand"
  fi
  fail "migration failed deploying $WANT_SHA - the site was never switched (schema may be partially changed; see the log)"
fi

# ---------------------------------------------------------------------------
# Flip, then prove it still serves. Give opcache a moment before deciding the
# deploy broke something. A smoke failure flips straight back to the previous
# release - two renames, no git involved - and the failed release is kept for
# inspection.
# ---------------------------------------------------------------------------
flip_site "$NEW_RELEASE"
sleep 3
BAD=$(smoke)
if [ -n "$BAD" ]; then
  if [ -n "$PREV_RELEASE" ]; then
    log "smoke failed on ${WANT_SHA:0:8}:$BAD - flipping back to ${HAVE_SHA:0:8}"
    flip_site "$PREV_RELEASE"
    sleep 3
    BACK=$(smoke)
    [ -z "$BACK" ] \
      || fail "deployed $WANT_SHA, smoke failed ($BAD), and the flip back to $HAVE_SHA is also unhealthy ($BACK)"
    fail "deployed $WANT_SHA but the site does not serve correctly:$BAD - flipped back to $HAVE_SHA (the release is kept at $NEW_RELEASE)"
  fi
  fail "smoke failed on ${WANT_SHA:0:8}:$BAD - and there is no previous release to fall back on"
fi

log "deployed $WANT_SHA - smoke passed"
echo "deployed $WANT_SHA"

apply_changelog "$(readlink -f "$CURRENT_LINK")"
signal_mcp "$WANT_SHA"
prune_releases "$(readlink -f "$CURRENT_LINK")" "$PREV_RELEASE"

# The copy that runs lives outside the releases on purpose: bash reads a
# script as it executes it, and a release may be pruned - or flipped away
# from - under a running one. The cost is that this script does not update
# itself - say so when it is stale.
MINE="$(dirname "$0")/$(basename "$0")"
THEIRS="$(readlink -f "$CURRENT_LINK")/deploy/$(basename "$0")"
if [ -r "$THEIRS" ] && ! cmp -s "$MINE" "$THEIRS"; then
  log "NOTE: $MINE differs from $THEIRS - reinstall it with: cp $THEIRS $MINE"
  echo "note: $MINE is out of date against the current release" >&2
fi
